#%RAML 1.0 DataType
description: Item exercising the nullable declarations the REST client generator supports
properties:
  id:
    type: string
    required: true
  label:
    type: string
    required: true
  note:
    type: string
    required: false
  enabled:
    type: boolean | nil
    required: true
  updated_at:
    type: datetime | nil
    required: true
  owner:
    type: Owner | nil
    required: true
  archived:
    type: boolean | null
    required: true
  score:
    type: integer?
    required: true
  nickname:
    type: string | nil
    required: false
  tags:
    type: array | nil
    required: true
    items:
      type: string
  status:
    type: string | nil
    required: true
    enum:
      - active
      - suspended

<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="vendor_nullable_types_api.item_manager"
                 class="Vendor\Test\NullableTypesApiBundle\Service\ItemManager">
            <argument type="service" id="vendor_nullable_types_api.repository.item"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
        </service>
        <service id="vendor_nullable_types_api.voter.item_scope"
                 class="Vendor\Test\NullableTypesApiBundle\Voter\ItemScopeVoter"
                 parent="paysera_security.security.context_aware_scope_voter"
                 public="false">
            <tag name="security.voter"/>
        </service>
        
        
    </services>
</container>

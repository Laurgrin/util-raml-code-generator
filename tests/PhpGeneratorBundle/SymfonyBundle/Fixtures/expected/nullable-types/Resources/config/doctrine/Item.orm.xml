<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity repository-class="Vendor\Test\NullableTypesApiBundle\Repository\ItemRepository"
            name="Vendor\Test\NullableTypesApiBundle\Entity\Item" table="nullable_types_api_items">

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="label" column="label" nullable="false" type="string"/>
        <field name="note" column="note" nullable="true" type="string"/>
        <field name="enabled" column="enabled" nullable="true" type="boolean"/>
        <field name="updatedAt" column="updated_at" nullable="true" type="datetime"/>
        <!--TODO: generated_code <field name="owner" column="owner" nullable="true" type="reference"/>-->
        <field name="archived" column="archived" nullable="true" type="boolean"/>
        <field name="score" column="score" nullable="true" type="integer"/>
        <field name="nickname" column="nickname" nullable="true" type="string"/>
        <!--TODO: generated_code non-scalar property <field name="tags" column="tags" nullable="true" type="array"/>-->
        <field name="status" column="status" nullable="true" type="string"/>
        <field name="payload" column="payload" nullable="true" type="object"/>
        <field name="attachment" column="attachment" nullable="true" type="file"/>
        
    </entity>
</doctrine-mapping>

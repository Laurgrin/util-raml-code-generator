#%RAML 1.0 DataType
description: Item exercising every nullable declaration the generator supports
properties:
  id:
    type: string
    required: true
  label:
    type: string
    required: true
  note:
    type: string
    required: false
  enabled:
    type: boolean | nil
    required: true
  updated_at:
    type: datetime | nil
    required: true
  owner:
    type: Owner | nil
    required: true

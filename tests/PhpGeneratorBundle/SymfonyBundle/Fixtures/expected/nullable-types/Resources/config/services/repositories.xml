<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="vendor_nullable_types_api.repository.item"
                 class="Vendor\Test\NullableTypesApiBundle\Repository\ItemRepository"
                 lazy="true">
            <factory service="doctrine.orm.entity_manager" method="getRepository"/>
            <argument>VendorNullableTypesApiBundle:Item</argument>
        </service>
        <service id="vendor_nullable_types_api.repository.owner"
                 class="Vendor\Test\NullableTypesApiBundle\Repository\OwnerRepository"
                 lazy="true">
            <factory service="doctrine.orm.entity_manager" method="getRepository"/>
            <argument>VendorNullableTypesApiBundle:Owner</argument>
        </service>
        
    </services>
</container>
